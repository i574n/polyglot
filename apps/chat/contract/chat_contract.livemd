### claim_alias

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl panic_str (text : string) : () =\n    $'near_sdk::env::panic_str(&*!text)' : ()\n\ninl claim_alias\n    (account_set : rust.ref (rust.mut' (near.iterable_set near.account_id)))\n    (alias_set : rust.ref (rust.mut' (near.iterable_set sm'.std_string)))\n    (account_map : rust.ref (rust.mut' (near.lookup_map near.account_id sm'.std_string)))\n    (alias_map : rust.ref (rust.mut' (near.lookup_map sm'.std_string alias_accounts)))\n    (alias : sm'.std_string)\n    : ()\n    =\n    inl signer_account_id = near.signer_account_id ()\n    inl predecessor_account_id = near.predecessor_account_id ()\n    inl block_timestamp = near.block_timestamp ()\n\n    trace Debug\n        fun () => \"chat_contract.claim_alias\"\n        fun () => {\n            alias\n            block_timestamp\n            signer_account_id = signer_account_id |> sm'.to_string'\n            predecessor_account_id = predecessor_account_id |> sm'.to_string'\n        }\n\n    if alias |> is_valid_alias |> not then\n        panic_str \"chat_contract.claim_alias / invalid alias\"\n\n    inl account_alias : optionm'.option' sm'.std_string =\n        $'(!account_map).get(&(!signer_account_id)).cloned()'\n\n    match account_alias |> optionm'.unbox with\n    | Some account_alias when account_alias =. alias =>\n        trace Warning\n            fun () => \"chat_contract.claim_alias / alias already claimed\"\n            fun () => { account_alias = account_alias |> sm'.format_debug }\n    | account_alias' =>\n        trace Debug\n            fun () => \"chat_contract.claim_alias\"\n            fun () => { account_alias = account_alias' |> optionm'.box |> sm'.format_debug }\n\n        match account_alias' with\n        | Some account_alias =>\n            $'{ if let Some(accounts) = (!alias_map).get_mut(&(!account_alias)) { accounts.remove(&(!signer_account_id)); } }' : ()\n        | None => ()\n\n        $'{ (!account_map).insert((!signer_account_id).clone(), (!alias).clone()); }' : ()\n\n        account_set |> near.iterable_set_insert signer_account_id |> ignore\n        alias_set |> near.iterable_set_insert alias |> ignore\n\n        $'{ let accounts = match (!alias_map).get(&(!alias)) { None => { let mut accounts = std::collections::HashMap::new(); accounts.insert((!signer_account_id).clone(), (!block_timestamp, 0u32)); accounts } Some(previous) => { let mut ordered = previous.iter().collect::<Vec<_>>(); ordered.sort_unstable_by_key(|(_, (_, index))| *index); let mut accounts = ordered.iter().enumerate().map(|(i, (account_id, (timestamp, _)))| ((*account_id).clone(), (*timestamp, i as u32))).collect::<std::collections::HashMap<_, _>>(); accounts.insert((!signer_account_id).clone(), (!block_timestamp, ordered.len() as u32)); accounts } }; (!alias_map).insert((!alias).clone(), accounts); }' : ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl panic_str (text : string) : () =
      $'near_sdk::env::panic_str(&*!text)' : ()

  inl claim_alias
      (account_set : rust.ref (rust.mut' (near.iterable_set near.account_id)))
      (alias_set : rust.ref (rust.mut' (near.iterable_set sm'.std_string)))
      (account_map : rust.ref (rust.mut' (near.lookup_map near.account_id sm'.std_string)))
      (alias_map : rust.ref (rust.mut' (near.lookup_map sm'.std_string alias_accounts)))
      (alias : sm'.std_string)
      : ()
      =
      inl signer_account_id = near.signer_account_id ()
      inl predecessor_account_id = near.predecessor_account_id ()
      inl block_timestamp = near.block_timestamp ()

      trace Debug
          fun () => "chat_contract.claim_alias"
          fun () => {
              alias
              block_timestamp
              signer_account_id = signer_account_id |> sm'.to_string'
              predecessor_account_id = predecessor_account_id |> sm'.to_string'
          }

      if alias |> is_valid_alias |> not then
          panic_str "chat_contract.claim_alias / invalid alias"

      inl account_alias : optionm'.option' sm'.std_string =
          $'(!account_map).get(&(!signer_account_id)).cloned()'

      match account_alias |> optionm'.unbox with
      | Some account_alias when account_alias =. alias =>
          trace Warning
              fun () => "chat_contract.claim_alias / alias already claimed"
              fun () => { account_alias = account_alias |> sm'.format_debug }
      | account_alias' =>
          trace Debug
              fun () => "chat_contract.claim_alias"
              fun () => { account_alias = account_alias' |> optionm'.box |> sm'.format_debug }

          match account_alias' with
          | Some account_alias =>
              $'{ if let Some(accounts) = (!alias_map).get_mut(&(!account_alias)) { accounts.remove(&(!signer_account_id)); } }' : ()
          | None => ()

          $'{ (!account_map).insert((!signer_account_id).clone(), (!alias).clone()); }' : ()

          account_set |> near.iterable_set_insert signer_account_id |> ignore
          alias_set |> near.iterable_set_insert alias |> ignore

          $'{ let accounts = match (!alias_map).get(&(!alias)) { None => { let mut accounts = std::collections::HashMap::new(); accounts.insert((!signer_account_id).clone(), (!block_timestamp, 0u32)); accounts } Some(previous) => { let mut ordered = previous.iter().collect::<Vec<_>>(); ordered.sort_unstable_by_key(|(_, (_, index))| *index); let mut accounts = ordered.iter().enumerate().map(|(i, (account_id, (timestamp, _)))| ((*account_id).clone(), (*timestamp, i as u32))).collect::<std::collections::HashMap<_, _>>(); accounts.insert((!signer_account_id).clone(), (!block_timestamp, ordered.len() as u32)); accounts } }; (!alias_map).insert((!alias).clone(), accounts); }' : ()
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> rust \"-c=-e=\\\"chat_contract.claim_alias / invalid alias\\\"\"\n\ninl state = new ()\n\"\"\n|> sm'.to_std_string\n|> claim_alias\n    (state.account_set |> rust.to_ref_mut)\n    (state.alias_set |> rust.to_ref_mut)\n    (state.account_map |> rust.to_ref_mut)\n    (state.alias_map |> rust.to_ref_mut)","print_code":false},"livebook_object":"smart_cell"} -->

