### print_digits
Prints a non-negative i32 in decimal (string arguments only: the C backend's Printf takes strings).

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let rec print_digits (n : i32) : () =\n    if n >= 10i32 then print_digits (n / 10i32)\n    inl d = n % 10i32\n    inl text = if d = 0i32 then \"0\" elif d = 1i32 then \"1\" elif d = 2i32 then \"2\" elif d = 3i32 then \"3\" elif d = 4i32 then \"4\" elif d = 5i32 then \"5\" elif d = 6i32 then \"6\" elif d = 7i32 then \"7\" elif d = 8i32 then \"8\" else \"9\"\n    print text","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let rec print_digits (n : i32) : () =
      if n >= 10i32 then print_digits (n / 10i32)
      inl d = n % 10i32
      inl text = if d = 0i32 then "0" elif d = 1i32 then "1" elif d = 2i32 then "2" elif d = 3i32 then "3" elif d = 4i32 then "4" elif d = 5i32 then "5" elif d = 6i32 then "6" elif d = 7i32 then "7" elif d = 8i32 then "8" else "9"
      print text
  """,
  timeout: 300_000
)
```

### main

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl main () : i32 =\n    inl frames = 60i32\n    inl size = width () * height ()\n    inl depth : a i32 f64 = am.init size (fun _ => 0f64)\n    inl chars : a i32 i32 = am.init size (fun _ => background ())\n    inl rot = mut (rotation { a = 0f64; b = 0f64; c = 0f64 })\n    inl checksum = mut 0i32\n    loopw.for' {from=0i32; nearTo=frames} fun _ =>\n        checksum <- render depth chars *rot *checksum\n        rot <- next_rotation *rot\n    print \"cube: \"\n    print_digits frames\n    print \" frames, checksum \"\n    print_digits *checksum\n    print \"\\n\"\n    0i32","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl main () : i32 =
      inl frames = 60i32
      inl size = width () * height ()
      inl depth : a i32 f64 = am.init size (fun _ => 0f64)
      inl chars : a i32 i32 = am.init size (fun _ => background ())
      inl rot = mut (rotation { a = 0f64; b = 0f64; c = 0f64 })
      inl checksum = mut 0i32
      loopw.for' {from=0i32; nearTo=frames} fun _ =>
          checksum <- render depth chars *rot *checksum
          rot <- next_rotation *rot
      print "cube: "
      print_digits frames
      print " frames, checksum "
      print_digits *checksum
      print "\n"
      0i32
  """,
  timeout: 300_000
)
```
